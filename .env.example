# PM2 deployment sets PORT from the GitHub variable APP_PORT (default 2027).
PORT=2027
HOST=127.0.0.1

# Build-time canonical URL. Rebuild the site after changing the domain.
NEXT_PUBLIC_SITE_URL=https://myaka.rumiscola.ru

# Timeweb Agent: copy the base URL from the agent dashboard and create its API access key.
# Set these only in /var/www/myaka/shared/.env, never in NEXT_PUBLIC_* or GitHub.
AI_AGENT_BASE_URL=
AI_AGENT_API_KEY=

# Legacy Timeweb AI Gateway, used only when AI_AGENT_BASE_URL is empty.
AI_GATEWAY_API_KEY=
