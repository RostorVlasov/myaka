# PM2 deployment sets PORT from the GitHub variable APP_PORT (default 2027).
PORT=2027
HOST=127.0.0.1

# Build-time canonical URL. Rebuild the site after changing the domain.
NEXT_PUBLIC_SITE_URL=https://myaka.rumiscola.ru

# Set on the server in /var/www/myaka/shared/.env. Never expose this in NEXT_PUBLIC_* or GitHub.
AI_GATEWAY_API_KEY=
